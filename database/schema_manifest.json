      "definition": "NOT NULL"
    },
    {
      "name": "cost_pence",
      "type": "BIGINT UNSIGNED",
      "definition": "NOT NULL"
    },
    {
      "name": "created_at",
      "type": "DATETIME",
      "definition": "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }
  ],
  "repairs": [
    {
      "name": "id",
      "type": "INT UNSIGNED",
      "definition": "AUTO_INCREMENT PRIMARY KEY"
    },
    {
      "name": "vehicle_id",
      "type": "INT UNSIGNED",
      "definition": "NOT NULL"
    },
    {
      "name": "repair_date",
      "type": "DATE",
      "definition": "NOT NULL"
    },
    {
      "name": "description",
      "type": "TEXT",
      "definition": "NOT NULL"
